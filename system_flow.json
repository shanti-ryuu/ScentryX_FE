  "architecture": {
    "layers": {
      "presentation": "Flutter UI Screens",
      "state_management": "Provider Pattern",
      "services": {
        "api_service": "Dio HTTP Client",
        "auth_service": "Firebase Auth + JWT",
        "firebase_service": "Realtime Database",
        "notification_service": "FCM + Local Notifications",
        "storage_service": "SharedPreferences + Secure Storage"
      }
    },
    "data_models": [
      "User",
      "Device",
      "Reading",
      "Alert",
      "ApiResponse"
    ],
    "api_endpoints": {
      "base_url": "http://10.0.2.2:5000/api",
      "auth": "/auth/login",
      "devices": "/devices",
      "readings": "/readings",
      "alerts": "/alerts",
      "users": "/users"
    }
  }
}
