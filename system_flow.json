              "status": "resolved",
              "resolvedAt": "2024-11-17T10:48:00Z",
              "createdAt": "2024-11-17T10:40:00Z"
            }
          ],
          "meta": {
            "activeAlerts": 1,
            "resolvedAlerts": 1,
            "totalAlerts": 2
          }
        }
      },
      "acknowledge_alert": {
        "request": {
          "alertId": "alert_001"
        },
        "response": {
          "success": true,
          "message": "Alert acknowledged",
          "statusCode": 200,
          "data": {
            "id": "alert_001",
            "status": "acknowledged",
            "acknowledgedAt": "2024-11-17T10:50:00Z"
          }
        }
      }
    },
