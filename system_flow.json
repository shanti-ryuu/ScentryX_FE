            }
          ],
          "meta": {
            "interval": 5,
            "maxPPM": 1000,
            "safeThreshold": 300,
            "dangerThreshold": 500
          }
        }
      },
      "get_readings_history": {
        "response": {
          "success": true,
          "message": "Readings history retrieved",
          "statusCode": 200,
          "data": [
            {
              "id": "reading_hist_001",
              "deviceId": "device_123",
