            "limit": 50,
            "startDate": "2024-11-17T00:00:00Z",
            "endDate": "2024-11-17T23:59:59Z"
          }
        }
      }
    },
    "alerts": {
      "get_alerts": {
        "response": {
          "success": true,
          "message": "Alerts retrieved",
          "statusCode": 200,
          "data": [
            {
              "id": "alert_001",
              "deviceId": "device_123",
              "alertType": "danger",
              "severity": "critical",
              "message": "High gas concentration detected",
              "status": "active",
              "resolvedAt": null,
